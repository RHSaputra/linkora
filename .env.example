# SQLite (default - works out of the box for local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL / MySQL (Recommended for production & millions of users)
# DATABASE_URL="postgresql://user:password@localhost:5432/linkvault?pgbouncer=true"

# NextAuth v5 Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Development Redirect URI: http://localhost:3000/api/auth/callback/google
# Production Redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Google Gemini API Key for AI Link Analyzer
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# Email Authentication & Resend Configuration
# ==========================================
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Sender Email Address:
# Development (Unverified Domain): "Linkora <onboarding@resend.dev>"
# Production (Verified Domain):    "Linkora <noreply@YOUR_PRODUCTION_DOMAIN>"
EMAIL_FROM="Linkora <onboarding@resend.dev>"
EMAIL_REPLY_TO="support@YOUR_PRODUCTION_DOMAIN"

# Application Base URL for Links and Redirects
APP_URL="http://localhost:3000"

# Security & Expiration Settings
OTP_EXPIRY_MINUTES="10"
EMAIL_DEBUG_MODE="true"
 
# ==========================================
# Google reCAPTCHA v2 (Checkbox "Saya bukan robot")
# ==========================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-google-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-google-recaptcha-secret-key"
